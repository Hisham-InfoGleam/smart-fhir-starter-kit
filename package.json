{
  "name": "smart-fhir-starter-kit",
  "version": "1.0.0",
  "description": "SMART on FHIR web app and an HL7 v2 to FHIR channel for OIE / Mirth, for learning and demos",
  "scripts": {
    "start:receiver": "cd mirth/mock-server && node server.js",
    "start:smart-app": "cd smart-app && python -m http.server 8000",
    "start:smart-app-npx": "npx http-server smart-app -p 8000 -c-1",
    "send:adt": "node mirth/send-hl7.js mirth/messages/ADT_A01.hl7",
    "send:oru": "node mirth/send-hl7.js mirth/messages/ORU_R01.hl7",
    "send:orm": "node mirth/send-hl7.js mirth/messages/ORM_O01.hl7",
    "test:receiver": "curl -X POST http://localhost:3000/fhir -H \"Content-Type: application/json\" -d \"{\\\"resourceType\\\":\\\"Patient\\\",\\\"id\\\":\\\"test-123\\\"}\"",
    "test:health": "curl http://localhost:3000/health",
    "check": "node --check mirth/channel-logic.js && node --check mirth/send-hl7.js && node --check mirth/mock-server/server.js && node --check smart-app/config.js"
  },
  "keywords": [
    "SMART",
    "FHIR",
    "HL7",
    "Mirth",
    "OIE",
    "Open Integration Engine",
    "healthcare",
    "interoperability",
    "education",
    "tutorial"
  ],
  "author": "Hisham Alrashdan <hisham@infogleam.com> (https://infogleam.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hisham-InfoGleam/smart-fhir-starter-kit"
  },
  "engines": {
    "node": ">=18"
  }
}
